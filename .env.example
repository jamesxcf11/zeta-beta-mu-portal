# ============================================================================
# Client-side (safe to expose — mirrored in js/supabase-config.js)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Server-side ONLY — set these as Netlify environment variables.
# NEVER commit real values and never reference them from js/ (client bundle).
# ============================================================================

# Used by netlify/functions/* to verify the caller's Supabase JWT
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 credentials (Object Read & Write, scoped to the bucket)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=zbm-media

# Public base URL for reads. Custom domain preferred over the
# account-specific *.r2.cloudflarestorage.com host.
R2_PUBLIC_BASE_URL=https://pub-751c6c343551429a8558c1260d49b887.r2.dev

# Upload limits enforced server-side in netlify/functions/upload-url.js
R2_MAX_UPLOAD_BYTES=10485760
