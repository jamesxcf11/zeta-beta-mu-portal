{
  "name": "zeta-beta-mu-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Zeta Beta Mu Fraternity Portal - static shell with Tailwind build step",
  "scripts": {
    "build:tw": "tailwindcss -i src/tailwind-input.css -o css/tailwind.css --minify",
    "build:css": "csso css/styles.css -o css/styles.min.css",
    "build": "npm run build:tw && npm run build:css",
    "watch:tw": "tailwindcss -i src/tailwind-input.css -o css/tailwind.css --watch",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@supabase/supabase-js": "^2.111.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "csso-cli": "^4.0.2",
    "http-server": "^14.1.1",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^3.4.17"
  }
}
